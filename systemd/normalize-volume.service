[Unit]
Description=Volumen de salida a un valor fijo (25%) al iniciar y al conectar dispositivos
Documentation=file:///mnt/Disco02/Projects/bluetooth-error/volumen-40.md
After=pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/hypr/scripts/normalize-volume.sh 25
Restart=always
RestartSec=3

[Install]
